# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=development

# --- DATABASE (MongoDB Atlas) ---
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin_user:<password>@cluster0.abcde.mongodb.net/smart_leads_db?retryWrites=true&w=majority

# --- SECURITY ---
# A secure 32-character (or longer) random string for signing JWT tokens
JWT_SECRET=fb6b7e0892c90666068800b3e648418086088241e3a6a9b4

# --- FRONTEND CONFIGURATION (Vite) ---
# Note: Variables prefixed with VITE_ are automatically exposed to the client-side code
VITE_API_URL=http://localhost:5000/api
